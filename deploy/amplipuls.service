[Unit]
Description=amplipuls.su (Astro + Node)
After=network.target

[Service]
Type=simple
User=amplipuls_su_usr
Group=amplipuls_su_usr
WorkingDirectory=/var/www/amplipuls_su_usr/data/www/amplipuls.su
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Если Node установлен через nvm — раскомментируйте ExecStart ниже и закомментируйте прямой вызов node.
ExecStart=/usr/bin/node dist/server/entry.mjs
# ExecStart=/bin/bash -lc 'source /var/www/amplipuls_su_usr/.nvm/nvm.sh && nvm use 22 && exec node dist/server/entry.mjs'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
